# ---------------------------------------------------------------------------
# OS / editors
# ---------------------------------------------------------------------------
.DS_Store
*.swp
*.log
.history/
.atom/
*.iml
*.ipr
*.iws
# Shared IDE settings are committed; personal ones are not.
.idea/*
!.idea/runConfigurations/
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json
# Personal Claude Code settings (shared .claude/settings.json may be committed).
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Dart / Flutter
# ---------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
# FVM-managed SDK checkout (keep .fvmrc / fvm_config.json if you use FVM).
.fvm/
# Golden test failure images.
**/failures/*.png
.pub-cache/
.pub/
build/
coverage/
**/doc/api/
.widget_preview/
migrate_working_dir/
# Only the workspace root lockfile is meaningful (pub workspaces).
**/pubspec.lock
!/pubspec.lock
pubspec_overrides.yaml

# Obfuscation / symbols from release builds
*.symbols
*.map.json
debug-info/

# ---------------------------------------------------------------------------
# Secrets and local configuration (never commit)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
**/config/*.local.json
**/android/key.properties
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
**/ios/ExportOptions.plist
